/* 全局样式：蓝白卡片风，字大留白多，方便在手机上长时间看 */
page {
  background: #f4f6fb;
  color: #1c2333;
  font-size: 28rpx;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  line-height: 1.6;
}

.wrap {
  padding: 24rpx 28rpx 48rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 6rpx 24rpx rgba(31, 45, 88, 0.06);
  margin-bottom: 24rpx;
}

.card--flat {
  box-shadow: none;
  border: 2rpx solid #eaeef7;
}

.row {
  display: flex;
  align-items: center;
}

.row--between {
  justify-content: space-between;
}

.row--gap {
  gap: 16rpx;
}

.col {
  display: flex;
  flex-direction: column;
}

.grow {
  flex: 1;
  min-width: 0;
}

.title {
  font-size: 34rpx;
  font-weight: 600;
}

.sub {
  color: #7b8497;
  font-size: 24rpx;
}

.muted {
  color: #a5acbb;
  font-size: 22rpx;
}

.strong {
  font-weight: 600;
}

.mt8 { margin-top: 8rpx; }
.mt16 { margin-top: 16rpx; }
.mt24 { margin-top: 24rpx; }
.mb16 { margin-bottom: 16rpx; }

.num {
  font-size: 48rpx;
  font-weight: 700;
  color: #3561f4;
  line-height: 1.2;
}

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: #eef2fd;
  color: #4a6bd6;
}

.tag--green {
  background: #e7f7ee;
  color: #1f9d55;
}

.tag--orange {
  background: #fff2e2;
  color: #d9821f;
}

.tag--gray {
  background: #f0f1f5;
  color: #868d9c;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  border-radius: 20rpx;
  font-size: 32rpx;
  font-weight: 500;
  background: #eef2fd;
  color: #3561f4;
  border: none;
  line-height: 1;
}

.btn::after {
  border: none;
}

.btn--primary {
  background: #3561f4;
  color: #fff;
}

.btn--ghost {
  background: #fff;
  color: #4a5266;
  border: 2rpx solid #dfe4f0;
}

.btn--danger {
  background: #fdeeee;
  color: #d94b4b;
}

.btn--grid {
  flex: 1;
}

.btn[disabled] {
  opacity: 0.45;
}

.bar {
  height: 12rpx;
  border-radius: 999rpx;
  background: #e8ecf6;
  overflow: hidden;
}

.bar__fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #6d8dff, #3561f4);
  transition: width 0.3s ease;
}

.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 0;
  border-bottom: 2rpx solid #f0f2f8;
}

.cell:last-child {
  border-bottom: none;
}

.input {
  height: 88rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  background: #f6f8fc;
  border-radius: 16rpx;
  font-size: 28rpx;
}

.textarea {
  width: 100%;
  min-height: 220rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  background: #f6f8fc;
  border-radius: 16rpx;
  font-size: 26rpx;
}

.empty {
  padding: 80rpx 0;
  text-align: center;
  color: #a5acbb;
  font-size: 26rpx;
}

.divider {
  height: 2rpx;
  background: #eef1f7;
  margin: 20rpx 0;
}
