.wordItem {
  margin-bottom: 16rpx;
  padding: 22rpx 24rpx;
}

.wordText {
  font-size: 32rpx;
}

.brief {
  color: #7b8497;
  font-size: 26rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.tailNote {
  text-align: center;
  padding: 24rpx 0 8rpx;
}

.link {
  color: #3561f4;
  font-size: 26rpx;
}

.result {
  background: #f6f8fc;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
}

.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: rgba(20, 28, 48, 0.45);
  display: flex;
  align-items: flex-end;
  box-sizing: border-box;
}

.sheet {
  width: 100%;
  margin-bottom: 0;
  border-radius: 32rpx 32rpx 0 0;
  padding: 36rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.sheetBody {
  max-height: 52vh;
}
