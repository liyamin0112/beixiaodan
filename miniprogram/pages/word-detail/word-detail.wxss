.word {
  font-size: 64rpx;
  font-weight: 700;
  color: #1c2333;
  line-height: 1.3;
  word-break: break-all;
}

.speaker {
  flex: none;
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: #eef2fd;
  color: #3561f4;
  font-size: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.meaningText {
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.5;
}

.example {
  font-size: 30rpx;
  line-height: 1.6;
}

.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: rgba(20, 28, 48, 0.45);
  display: flex;
  align-items: flex-end;
  box-sizing: border-box;
}

.sheet {
  width: 100%;
  margin-bottom: 0;
  border-radius: 32rpx 32rpx 0 0;
  padding: 36rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.sheetBody {
  max-height: 52vh;
}
