<view class="wrap">
  <view wx:if="{{error}}" class="card">
    <view class="title">单词没加载出来</view>
    <view class="sub mt8">{{error}}</view>
    <button class="btn btn--ghost mt24" bindtap="onTapRetry">重新加载</button>
  </view>

  <view wx:elif="{{loading}}" class="empty">加载中</view>

  <block wx:elif="{{word}}">
    <view class="card">
      <view class="row row--between row--gap">
        <view class="col grow">
          <view class="word">{{word.word}}</view>
          <view wx:if="{{word.phonetic}}" class="sub mt8">{{word.phonetic}}</view>
        </view>
        <view class="speaker" bindtap="onTapSpeak">🔊</view>
      </view>
    </view>

    <view class="card">
      <view class="sub">释义</view>
      <view class="row row--gap mt8">
        <text wx:if="{{word.pos}}" class="tag">{{word.pos}}</text>
        <view class="grow meaningText">{{word.meaning}}</view>
      </view>
    </view>

    <view wx:if="{{word.example}}" class="card">
      <view class="sub">例句</view>
      <view class="example mt8">{{word.example}}</view>
      <view wx:if="{{word.exampleCn}}" class="sub mt8">{{word.exampleCn}}</view>
    </view>

    <view class="card">
      <view class="row row--between">
        <view class="sub">学习状态</view>
        <text class="tag {{st.cls}}">{{st.label}}</text>
      </view>
      <view class="row row--between mt16">
        <view class="muted">{{book.title}}</view>
        <view class="muted">{{dueText ? '下次复习：' + dueText : '还没有复习计划'}}</view>
      </view>
    </view>

    <view class="row row--gap mt24">
      <button wx:if="{{!book.editable}}" class="btn btn--primary btn--grid" bindtap="onTapAddToMine">加入我的词库</button>
      <block wx:else>
        <button class="btn btn--grid" bindtap="onTapEdit">编辑</button>
        <button class="btn btn--danger btn--grid" bindtap="onTapDelete">删除</button>
      </block>
    </view>
    <view wx:if="{{!book.editable}}" class="muted mt16">内置词库里的单词只能复制到自己的词库，不能直接修改。</view>

    <view wx:if="{{editVisible}}" class="mask" bindtap="onTapCloseEdit">
      <view class="card sheet" catchtap="noop">
        <view class="title">编辑单词</view>
        <scroll-view scroll-y class="sheetBody">
          <input class="input mt16" placeholder="单词" value="{{form.word}}" data-field="word" bindinput="onFormInput" />
          <input class="input mt16" placeholder="中文释义（必填）" value="{{form.meaning}}" data-field="meaning" bindinput="onFormInput" />
          <input class="input mt16" placeholder="音标" value="{{form.phonetic}}" data-field="phonetic" bindinput="onFormInput" />
          <input class="input mt16" placeholder="词性" value="{{form.pos}}" data-field="pos" bindinput="onFormInput" />
          <input class="input mt16" placeholder="例句" value="{{form.example}}" data-field="example" bindinput="onFormInput" />
          <input class="input mt16" placeholder="例句翻译" value="{{form.exampleCn}}" data-field="exampleCn" bindinput="onFormInput" />
        </scroll-view>
        <view class="row row--gap mt24">
          <button class="btn btn--ghost btn--grid" bindtap="onTapCloseEdit">取消</button>
          <button class="btn btn--primary btn--grid" bindtap="onTapSaveEdit">保存</button>
        </view>
      </view>
    </view>
  </block>
</view>
